# OpenAI API key, used by every agent in the pipeline
OPENAI_API_KEY=your-openai-api-key

# SendGrid API key, used to send the final report by email
SENDGRID_API_KEY=your-sendgrid-api-key

# Must be a verified sender identity in your SendGrid account
SENDER_EMAIL=you@example.com

# Inbox that should receive the finished report
RECIPIENT_EMAIL=you@example.com
